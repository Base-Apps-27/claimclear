modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift"

[[workflows.workflow]]
name = "schema-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run check-drift"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["outlook:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-aa15283a-2ca4-4bf5-b949-fffbd7690c1c"

[userenv]

[userenv.shared]
BOT_SERVICE_TOKEN = "0a813f710d64667100d51fc992fbf9c1e81f58f900d76e2e8941ce05608d5183"
MAS_PORTAL_URL = "https://tpissues.medanswering.com"

[[ports]]
localPort = 5924
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80
