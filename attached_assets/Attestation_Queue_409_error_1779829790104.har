ropNote\":null,\"droppedAt\":null,\"readyAt\":\"2026-05-09T17:08:53.107Z\",\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":\"none\",\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T15:18:48.915Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:49:20.025Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:02.468Z\",\"updatedAt\":\"2026-05-14T15:18:48.915Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T15:18:48.915Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1045,\"invoiceNumber\":\"1869452960\",\"clientNumber\":\"SE80450R\",\"errorDetails\":\"GPS pickup too far from residence; Leg is in GPS Deviation Status.\",\"errorTypeId\":\"3\",\"errorTypeName\":\"GPS Pickup Too Far from Residence\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T15:16:44.038Z\",\"approvedAmount\":\"117.63\",\"rideCount\":2,\"serviceDate\":\"2026-04-26\",\"totalAmount\":\"117.63\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1869452960 - GPS Pickup Too Far from Residence (2 rides)\",\"draftDescriptionHtml\":\"Reconsideration Request – GPS Pickup Too Far from Residence – Invoice #1869452960\\n\\nWe are disputing the GPS Pickup Too Far from Residence flags on Invoice #1869452960 and requesting reconsideration for Conf #15063144 and Conf #15063145, both serviced on 2026-04-26. These trips were flagged as GPS deviations, but the available breadcrumb data does not support that conclusion for either leg.\\n\\nFor Conf #15063144 (Car 2022), GPS breadcrumb data is available and directly supports that pickup occurred at or near the member's residence. The flag does not reflect an actual deviation from the authorized pickup location. For Conf #15063145 (Car 1706), the GPS route data reasonably supports a valid trip between the pickup and dropoff points, confirming the trip was completed as authorized. In both cases, the deviation status appears to be a system-generated flag that is contradicted by the underlying GPS evidence.\\n\\nThe attached GPS breadcrumb data for each confirmation serves as the primary supporting documentation. It confirms accurate pickup placement for Conf #15063144 and a valid, complete route for Conf #15063145. Based on this documentation, both trips qualify as valid and we request that the claims be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1869452960 - GPS Pickup Too Far from Residence (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Reconsideration Request – GPS Pickup Too Far from Residence – Invoice #1869452960**\\n\\nWe are disputing the GPS Pickup Too Far from Residence flags on Invoice #1869452960 and requesting reconsideration for Conf #15063144 and Conf #15063145, both serviced on 2026-04-26. These trips were flagged as GPS deviations, but the available breadcrumb data does not support that conclusion for either leg.\\n\\nFor Conf #15063144 (Car 2022), GPS breadcrumb data is available and directly supports that pickup occurred at or near the member's residence. The flag does not reflect an actual deviation from the authorized pickup location. For Conf #15063145 (Car 1706), the GPS route data reasonably supports a valid trip between the pickup and dropoff points, confirming the trip was completed as authorized. In both cases, the deviation status appears to be a system-generated flag that is contradicted by the underlying GPS evidence.\\n\\nThe attached GPS breadcrumb data for each confirmation serves as the primary supporting documentation. It confirms accurate pickup placement for Conf #15063144 and a valid, complete route for Conf #15063145. Based on this documentation, both trips qualify as valid and we request that the claims be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T17:18:41.155Z\",\"draftEditedBy\":\"KATIA.H@AGAPENY.COM\",\"draftReviewedAt\":\"2026-05-09T17:18:41.636Z\",\"draftReviewedBy\":\"KATIA.H@AGAPENY.COM\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-09T17:18:17.317Z\",\"previewGeneratedBy\":\"KATIA.H@AGAPENY.COM\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-14T15:16:44.001Z\",\"reattestCompletedBy\":\"someidy.s@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":true,\"disputeEmailSentAt\":\"2026-05-09T21:34:05.279Z\",\"generatedEmailSubject