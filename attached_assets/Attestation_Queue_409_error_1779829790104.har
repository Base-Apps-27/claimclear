SelectorAll('.portal-attachment-thumbnail-img').forEach(function(img) {\\n img.addEventListener('error', function () {\\n attachment_error_image(this);\\n });\\n });\\n\\n const attachment_error_image = (attachment) => {\\n const parentElement = attachment.parentElement;\\n const defaultIcon = `${escapeHtml(attachment.dataset.extension)}`;\\n parentElement.innerHTML = defaultIcon;\\n };\",\"rawContent\":\"GPS Exemption Request Approved\\nA detailed review of the GPS data received for invoice 1881682210 confirmed GPS compliance despite the event IDs submitted via GPS being incorrect.\\nImportant Notice:\\nThe GPS Deviation on this trip may have been caused by:\\n\\nUser error - Your company should provide training for drivers on proper GPS application utilization\\n\\nTPI software issues - If using third-party software, share this information with your TPI\\n\\nYour GPS Exemption Request for 1881682210 is approved.\\nThe invoice will be made attestable within two business days.\\n\\nNote: Exceptions granted for user error or TPI software issues will not be available indefinitely. Please work to resolve these issues.\\n \\n \\n\\n document.querySelectorAll('.portal-attachment-thumbnail-img').forEach(function(img) {\\n img.addEventListener('error', function () {\\n attachment_error_image(this);\\n });\\n });\\n\\n const attachment_error_image = (attachment) => {\\n const parentElement = attachment.parentElement;\\n const defaultIcon = `${escapeHtml(attachment.dataset.extension)}`;\\n parentElement.innerHTML = defaultIcon;\\n };\",\"bodyFormat\":\"text\",\"senderEmail\":null,\"senderName\":\"Transportation Provider\",\"matchedVia\":\"portal_ticket_id:92294\",\"matchConfidence\":\"high\",\"portalTicketId\":\"92294\",\"externalMessageId\":\"hash:9eaf51da\",\"conversationId\":null,\"processed\":false,\"autoLinked\":true,\"aiSummary\":\"Payor approved the GPS Exemption Request for invoice 1881682210. GPS compliance was confirmed despite incorrect event IDs. Invoice will be 