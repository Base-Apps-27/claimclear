trip\",\"nodeId\":\"node_1778278335139_10mic\"},{\"ts\":\"2026-05-21T15:47:23.122Z\",\"answer\":\"Yes, discrepancy is explainable\",\"nodeId\":\"node_1778278335139_7e1cx\"}],\"sopOutcome\":\"portal_dispute\",\"dropReason\":null,\"dropNote\":null,\"droppedAt\":null,\"readyAt\":\"2026-05-21T15:47:23.138Z\",\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":\"none\",\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"queued\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":\"1. Re-attest the invoice.\",\"attestationQueuedAt\":\"2026-05-25T14:05:14.707Z\",\"attestationQueuedBy\":\"z7ytv7jcb4@privaterelay.appleid.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-30T15:09:09.080Z\",\"updatedAt\":\"2026-05-26T15:22:33.019Z\"},\"attestationOutcome\":\"queued\",\"outcomeAt\":\"2026-05-25T14:05:14.707Z\",\"outcomeBy\":\"z7ytv7jcb4@privaterelay.appleid.com\",\"outcomeNote\":\"1. Re-attest the invoice.\"}]},{\"group\":{\"id\":1155,\"invoiceNumber\":\"1811560380\",\"clientNumber\":\"FP11388E\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T14:56:49.630Z\",\"approvedAmount\":\"46.64\",\"rideCount\":2,\"serviceDate\":\"2026-04-29\",\"totalAmount\":\"46.64\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1811560380 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1811560380, covering Conf #15043045 and Conf #15043046 (both serviced 2026-04-29), and requesting that these trips be reconsidered for approval.\\n\\nFor both rides, available GPS and trip timing data was reviewed and does not support the denial. The timing recorded for each trip reasonably reflects the actual facility stay -- there is no indication that the member spent an unusually short or implausible amount of time at the facility. The flagged edit does not represent a true deviation from expected trip behavior.\\n\\nSupporting timing data is attached for both confirmation numbers. This documentation confirms that the trips were completed as authorized and that the facility time recorded is consistent with a valid, completed transport. We request that both trips on this invoice be approved in accordance with the documented evidence.\",\"aiBaselineSubject\":\"Dispute - Invoice #1811560380 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1811560380, covering Conf #15043045 and Conf #15043046 (both serviced 2026-04-29), and requesting that these trips be reconsidered for approval.\\n\\nFor both rides, available GPS and trip timing data was reviewed and does not support the denial. The timing recorded for each trip reasonably reflects the actual facility stay -- there is no indication that the member spent an unusually short or implausible amount of time at the facility. The flagged edit does not represent a true deviation from expected trip behavior.\\n\\nSupporting timing data is attached for both confirmation numbers. This documentation confirms that the trips were completed as authorized and that the facility time recorded is consistent with a valid, completed transport. We request that both trips on this invoice be approved in accordance with the documented evidence.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-20T19:05:46.824Z\",\"draftEditedBy\":\"KATIA.H@AGAPENY.COM\",\"draftReviewedAt\":\"2026-05-20T19:05:55.354Z\",\"draftReviewedBy\":\"KATIA.H@AGAPENY.COM\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-20T19:05:46.824Z\",\"previewGeneratedBy\":\"KATIA.H@AGAPENY.COM\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-26T14:56:49.597Z\",\"reattestCompletedBy\":\"Grace@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":true,\"disputeEmailSentAt\":\"2026-05-20T22:54:59.834Z\",\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"payorEmail\":null,\"payorDenialReason\":null,\"payorDenialReasonNote\":null,\"payorDenialReasonAt\":null,\"payorDenialReasonBy\":null,\"awaitingPayorAgainAt\":\"2026-05-22T12:30:31.105Z\",\"importBatch\":\"import_1777561745579\",\"isTourSample\":false,\"withdrawnAt\":null,\"draftDiscard