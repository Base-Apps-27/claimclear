sureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-08T20:05:47.334Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":null,\"attestationQueuedBy\":null,\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:06:08.764Z\",\"updatedAt\":\"2026-05-10T01:55:00.795Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-08T20:05:47.334Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":322,\"invoiceNumber\":\"1804580940\",\"clientNumber\":\"MX88498Z\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-07T00:50:57.113Z\",\"approvedAmount\":\"45.94\",\"rideCount\":2,\"serviceDate\":\"2026-04-06\",\"totalAmount\":\"45.94\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1804580940 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"**Reconsideration Request – Time at Medical Facility Too Short – Invoice #1804580940**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" edit flagged on invoice #1804580940 and requesting reconsideration for Conf #14899548 and Conf #14899545, both serviced on 04/06/2026 under client MX88498Z.\\n\\nFor both trips, available GPS and timing data was reviewed and does not support the denial. The recorded facility time is consistent with what would reasonably be expected for the type of appointment completed. This is not a case where the data reflects an unusually brief or questionable stay. The timing reasonably supports that both trips were completed as authorized.\\n\\nThe attached trip timing data confirms this for each confirmation number. Based on the documentation on file, neither trip represents a true deviation, and we request that both claims be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1804580940 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Reconsideration Request – Time at Medical Facility Too Short – Invoice #1804580940**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" edit flagged on invoice #1804580940 and requesting reconsideration for Conf #14899548 and Conf #14899545, both serviced on 04/06/2026 under client MX88498Z.\\n\\nFor both trips, available GPS and timing data was reviewed and does not support the denial. The recorded facility time is consistent with what would reasonably be expected for the type of appointment completed. This is not a case where the data reflects an unusually brief or questionable stay. The timing reasonably supports that both trips were completed as authorized.\\n\\nThe attached trip timing data confirms this for each confirmation number. Based on the documentation on file, neither trip represents a true deviation, and we request that both claims be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-06T14:52:07.647Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":\"2026-05-06T14:52:11.959Z\",\"draftReviewedBy\":\"someidy.s@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-06T14:52:07.647Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-07T22:26:01.620Z\",\"reat