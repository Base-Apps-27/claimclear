ll,\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"not_required\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":null,\"attestationQueuedAt\":null,\"attestationQueuedBy\":null,\"isOpen\":true,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-05-19T14:42:08.103Z\",\"updatedAt\":\"2026-05-26T16:07:10.369Z\"},\"attestationOutcome\":\"not_required\",\"outcomeAt\":null,\"outcomeBy\":null,\"outcomeNote\":null}]},{\"group\":{\"id\":1773,\"invoiceNumber\":\"1879959750\",\"clientNumber\":\"VC01377H\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T15:56:52.091Z\",\"approvedAmount\":\"45.94\",\"rideCount\":2,\"serviceDate\":\"2026-05-18\",\"totalAmount\":\"45.94\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1879959750 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1879959750 and requesting reconsideration of both affected trips, Conf #15177698 and Conf #15177699, serviced on 2026-05-18 under client VC01377H.\\n\\nFor both rides, GPS and trip timing data are available and have been reviewed. That data does not support the denial. The facility stay duration reflected in the timing records is reasonable and consistent with a legitimate completed trip. The flag does not accurately represent what occurred on either run.\\n\\nThe available timing documentation is being submitted alongside this dispute and directly contradicts the basis for the edit. Based on the trip data and applicable guidelines, both of these are valid, completed trips and we request that they be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1879959750 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1879959750 and requesting reconsideration of both affected trips, Conf #15177698 and Conf #15177699, serviced on 2026-05-18 under client VC01377H.\\n\\nFor both rides, GPS and trip timing data are available and have been reviewed. That data does not support the denial. The facility stay duration reflected in the timing records is reasonable and consistent with a legitimate completed trip. The flag does not accurately represent what occurred on either run.\\n\\nThe available timing documentation is being submitted alongside this dispute and directly contradicts the basis for the edit. Based on the trip data and applicable guidelines, both of these are valid, completed trips and we request that they be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-20T17:39:18.573Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":\"2026-05-20T17:39:22.914Z\",\"draftReviewedBy\":\"someidy.s@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-20T17:39:18.573Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":