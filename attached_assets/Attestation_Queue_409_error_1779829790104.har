l,\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"includedInDispute\":true,\"sopNodeId\":\"node_1775756909222_83htk\",\"sopAnswers\":[{\"ts\":\"2026-05-15T17:44:28.906Z\",\"answer\":\"Yes, trip/leg completed\",\"nodeId\":\"node_1775756909222_kdkgj\"},{\"ts\":\"2026-05-15T17:44:31.520Z\",\"answer\":\"Yes, completion verified\",\"nodeId\":\"node_1775756909222_t6jpj\"},{\"ts\":\"2026-05-15T17:46:27.905Z\",\"answer\":\"Yes, Correction Request available\",\"nodeId\":\"node_1775756909222_83htk\"}],\"sopOutcome\":\"portal_dispute\",\"dropReason\":null,\"dropNote\":null,\"droppedAt\":null,\"readyAt\":\"2026-05-15T17:46:27.921Z\",\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":\"none\",\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-18T14:15:18.411Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":null,\"attestationQueuedBy\":null,\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:38:49.054Z\",\"updatedAt\":\"2026-05-18T14:15:18.411Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-18T14:15:18.411Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":418,\"invoiceNumber\":\"1858915060\",\"clientNumber\":\"WD94249B\",\"errorDetails\":\"GPS pickup too far from residence; Travel time is too short for distance traveled; Leg is in GPS Deviation Status.\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-15T15:04:56.938Z\",\"approvedAmount\":\"175.06\",\"rideCount\":2,\"serviceDate\":\"2026-04-08\",\"totalAmount\":\"175.06\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1858915060 - GPS Deviation Status (2 rides)\",\"draftDescriptionHtml\":\"**Reconsideration Request – GPS Deviation Status – Invoice #1858915060**\\n\\nWe are disputing the GPS Deviation Status flags on Invoice #1858915060 and requesting reconsideration for two affected trips: Conf #14937421 (Car 381) and Conf #14937422 (Car 3830), both serviced on 04/08/2026.\\n\\nFor Conf #14937421, the system flagged the pickup as too far from the member's residence. GPS breadcrumb data is available for this trip and reasonably supports that the pickup occurred at or near the member's location. The deviation does not reflect an actual service error. For Conf #14937422, the flag cites travel time too short for the distance traveled. The available GPS route data reasonably supports a valid trip between the pickup and dropoff points, confirming that the route was completed as assigned.\\n\\nIn both cases, GPS breadcrumb data has been reviewed and supports the legitimacy of each trip. The attached GPS evidence for each confirmation documents actual vehicle movement consistent with the authorized service. These are valid, completed trips and we request that both claims be approved in accordance with the supporting documentation.\",\"aiBaselineSubject\":\"Dispute - Invoice #1858915060 - GPS Deviation Status (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Reconsideration Request – GPS Deviation Status – Invoice #1858915060**\\n\\nWe are disputing the GPS Deviation Status flags on Invoice #1858915060 and requesting reconsideration for two affected trips: Conf #14937421 (Car 381) and Conf #14937422 (Car 3830), both serviced on 04/08/2026.\\n\\nFor Conf #14937421, the system flagged the pickup as too far from the member's residence. GPS breadcrumb data is available for this trip and reasonably supports that the pickup occurred at or near the member's location. The deviation does not reflect an actual service error. For Conf #14937422, the flag cites travel time too short for the distance traveled. The available GPS route data reasonably supports a valid trip between the pickup and dropoff points, confirming that the route was completed as assigned.\\n\\nIn both cases, GPS breadcrumb data has been reviewed and supports the legitimacy of each trip. The attached GPS evidence for each confirmation documents actual vehicle movement consistent with the authorized service. These are valid, completed trips and we request that both claims be approved in accordance with the supporting documentation.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-08T19:07:57.405Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":\"2026-05-08T19:08:01.194Z\",\"draftReviewedBy\":\"someidy.s@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-08T19:07:57.405Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-15T15:04:56.906Z\",\"reattestCompletedBy\":\"daniel.m@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\