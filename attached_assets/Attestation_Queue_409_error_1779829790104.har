ll,\"reasoning\":null,\"createdBy\":\"someidy.s@agapeny.com\",\"inspectionTimeMs\":null,\"createdAt\":\"2026-05-21T18:49:51.384Z\"},\"evidence\":[{\"id\":4058,\"claimId\":3241,\"invoiceGroupId\":null,\"evidenceTypeId\":null,\"evidenceTypeName\":\"GPS Screenshot\",\"treeNodeId\":\"node_1776188580433_18\",\"imageUrl\":\"/objects/uploads/07bf7a24-cfb1-46ca-9546-28b96cef8099.png\",\"notes\":null,\"collectedBy\":\"someidy.s@agapeny.com\",\"collectedAt\":\"2026-05-20T17:42:54.956Z\",\"closureScope\":null,\"closureReasonAtAttach\":null},{\"id\":4059,\"claimId\":3241,\"invoiceGroupId\":null,\"evidenceTypeId\":null,\"evidenceTypeName\":\"Receipt (only if member signature is present)\",\"treeNodeId\":\"node_1776188580433_18\",\"imageUrl\":\"/objects/uploads/96706e1d-84a5-484c-9bd3-a16a984e787b.png\",\"notes\":null,\"collectedBy\":\"someidy.s@agapeny.com\",\"collectedAt\":\"2026-05-20T17:42:55.044Z\",\"closureScope\":null,\"closureReasonAtAttach\":null},{\"id\":4060,\"claimId\":3241,\"invoiceGroupId\":null,\"evidenceTypeId\":null,\"evidenceTypeName\":\"Limosys Job Prevalidation Issues Screenshot\",\"treeNodeId\":\"node_1776188580433_18\",\"imageUrl\":\"/objects/uploads/08f2fd9c-4573-4b9a-9a55-a2c192e91e28.png\",\"notes\":null,\"collectedBy\":\"someidy.s@agapeny.com\",\"collectedAt\":\"2026-05-20T17:42:55.115Z\",\"closureScope\":null,\"closureReasonAtAttach\":null}]}],\"submissions\":[{\"id\":1673,\"invoiceGroupId\":1762,\"status\":\"submitted\",\"issueType\":\"GPS Control Deviation\",\"subject\":\"Dispute - Invoice #1877954550 - GPS Deviation Status (2 rides)\",\"requesterEmail\":\"Accounting@agapeny.com\",\"transportationProviderName\":\"Agape Luxury Corp\",\"phoneNumber\":\"7185852222\",\"invoiceNumber\":\"1877954550\",\"gpsBreadcrumbsAvailable\":\"Yes\",\"descriptionHtml\":\"We are disputing the GPS Deviation Status flags on invoice 1877954550, covering confirmation numbers 15158604 and 15158602 (both serviced 2026-05-18), and requesting that these trips be reconsidered for approval.\\n\\nBoth rides were flagged due to GPS pickup distance from the member's residence; however, this does not reflect a true deviation. GPS breadcrumb data is available for each trip, and in both cases the recorded route reasonably supports a valid, completed transport from pickup to drop-off. The flagged pickup coordinates align with a legitimate boarding location and do not indicate that the trip was fabricated or materially different from what was authorized.\\n\\nThe available GPS breadcrumb data confirms that each vehicle traveled an appropriate route consistent with the scheduled service. Based on this documentation, both trips were completed as authorized and the deviation edits should not stand. We request that these claims be approved in accordance with the supporting GPS evidence and applicable guidelines.\",\"descriptionEditorEmail\":\"someidy.s@agapeny.com\",\"descriptionEditorName\":null,\"descriptionHistory\":[],\"attachmentUrls\":[\"/objects/uploads/07bf7a24-cfb1-46ca-9546-28b96cef8099.png\",\"/objects/uploads/96706e1d-84a5-484c-9bd3-a16a984e787b.png\",\"/objects/uploads/08f2fd9c-4573-4b9a-9a55-a2c192e91e28.png\",\"/objects/uploads/8dc64b04-8168-4e42-8187-a511272f8138.png\",\"/objects/uploads/84c3d324-9813-4be2-a564-a63b729c3dc7.png\",\"/objects/uploads/3124f4ae-8195-4bef-af0b-5af9fad7ed95.png\"],\"legs\":[{\"error\":null,\"legId\":3241,\"ticked\":true,\"confNumber\":\"15158604\"},{\"error\":null,\"legId\":3242,\"ticked\":true,\"confNumber\":\"15158602\"}],\"confNumber\":\"15158604, 15158602\",\"serviceDate\":\"2026-05-18\",\"refNumber\":\"1877954550\",\"clientNumber\":\"QZ64626Z\",\"carNumber\":\"972, 5113\",\"claimAmount\":\"131.41\",\"errorTypeName\":\"GPS Deviation Status\",\"errorDetails\":\"Leg is in GPS Deviation Status.; GPS pickup too far from residence\",\"disputeReason\":\"\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackAt\":null,\"evidenceNotes\":\"\",\"evidenceFiles\":null,\"portalTicketId\"