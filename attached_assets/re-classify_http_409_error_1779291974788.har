on\":\"not_packageable\"},\"reattest\":{\"eligible\":false,\"reason\":\"has_disputable_legs\"},\"close\":{\"eligible\":false,\"reason\":\"has_disputable_legs\"}},\"legCount\":1,\"primaryLeg\":{\"id\":2251,\"confNumber\":\"15090611\"}},{\"id\":1194,\"invoiceNumber\":\"1868653930\",\"clientNumber\":\"WA22723S\",\"errorDetails\":\"GPS destination too far from residence\",\"errorTypeId\":\"5\",\"errorTypeName\":\"GPS Destination Too Far from Medical Facility\",\"status\":\"New\",\"outcome\":\"Pending\",\"phase\":\"triage\",\"phaseEnteredAt\":\"2026-05-07T00:50:57.113Z\",\"approvedAmount\":null,\"rideCount\":2,\"serviceDate\":\"2026-05-01\",\"totalAmount\":\"45.94\",\"groupContext\":null,\"draftSubject\":null,\"draftDescriptionHtml\":null,\"aiBaselineSubject\":null,\"aiBaselineDescriptionHtml\":null,\"draftEditedAt\":\"2026-05-18T17:04:42.252Z\",\"draftEditedBy\":\"krisalys.p@agapeny.com\",\"draftReviewedAt\":null,\"draftReviewedBy\":null,\"specialCircumstances\":null,\"understandingReadback\":\"You are disputing Invoice #1868653930, which contains two rides for client WA22723S on 2026-05-01, flagged under the GPS Destination Too Far from Medical Facility error type. For Conf #15059831 (Car 5223), you are arguing that the GPS breadcrumb data supports a successful dropoff at or near the medical facility, making the flag erroneous. For Conf #15059830 (Car 1143), the framing is different — this was a return trip to the client's residence, not a medical facility, and the GPS data confirms the vehicle dropped off directly in front of the correct home address, so the \\\"too far from medical facility\\\" flag is inapplicable to this leg by definition. Your core ask is to have both legs paid, supported by GPS destination evidence showing each dropoff was completed at the appropriate and intended location.\",\"understandingReadbackForText\":\"The drop off for Conf # 15059830 is to the residence not the medical facility. The GPS breadcrumbs show that the drop off was completed su