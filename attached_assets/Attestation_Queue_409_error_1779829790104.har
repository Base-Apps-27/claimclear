            "size": 695778,
            "mimeType": "application/json",
            "text": "{\"groups\":[{\"group\":{\"id\":1770,\"invoiceNumber\":\"1881682210\",\"clientNumber\":\"TQ47707Y\",\"errorDetails\":\"GPS pickup too far from medical facility\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T16:07:09.910Z\",\"approvedAmount\":\"106.40\",\"rideCount\":2,\"serviceDate\":\"2026-05-18\",\"totalAmount\":\"106.40\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1881682210 - GPS Deviation Status (1 ride)\",\"draftDescriptionHtml\":\"We are disputing the GPS Deviation Status flag on Conf #15197557 (Invoice 1881682210) and requesting that this claim be reconsidered for approval.\\n\\nThe denial indicates that the GPS pickup location was too far from the medical facility, but this does not reflect a true deviation. GPS breadcrumb data is available for this trip and confirms that the route traveled reasonably supports a valid pickup-to-drop-off sequence. The flagged distance does not indicate a missed or improper pickup; it reflects a geographic discrepancy that the breadcrumb trail directly contradicts.\\n\\nThe available GPS data shows a logical and continuous route consistent with the authorized trip. Based on this documentation, this is a valid completed trip and we request that it be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1881682210 - GPS Deviation Status (1 ride)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS Deviation Status flag on Conf #15197557 (Invoice 1881682210) and requesting that this claim be reconsidered for approval.\\n\\nThe denial indicates that the GPS pickup location was too far from the medical facility, but this does not reflect a true deviation. GPS breadcrumb data is available for this trip and confirms that the route traveled reasonably supports a valid pickup-to-drop-off sequence. The flagged distance does not indicate a missed or improper pickup; it reflects a geographic discrepancy that the breadcrumb trail directly contradicts.\\n\\nThe available GPS data shows a logical and continuous route consistent with the authorized trip. Based on this documentation, this is a valid completed trip and we request that it be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-20T17:40:37.440Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":\"2026-05-20T17:40:41.427Z\",\"draftReviewedBy\":\"someidy.s@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-20T17:40:37.440Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-26T16:07:09.876Z\",\"reattestCompletedBy\":\"daniel.m@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":true,\"disputeEmailSentAt\":\"2026-05-20T18:08:20.056Z\",\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"payorEmail\":null,\"payorDenialReason\":null,\"payorDenialReasonNote\":null,\"payorDenialReasonAt\":null,\"payorDenialReasonBy\":null,\"awaitingPayorAgainAt\":\"2026-05-21T18:50:17.534Z\",\"importBatch\":\"import_1779201725402\",\"isTourSample\":false,\"withdrawnAt\":null,\"draftDiscardedAt\":null,\"draftDiscardedSubject\":null,\"draftDiscardedDescriptionHtml\":null,\"isOpen\":false,\"createdAt\":\"2026-05-19T14:42:08.070Z\",\"updatedAt\":\"2026-05-26T16:07:09.947Z\"},\"legs\":[{\"claim\":{\"id\":3258,\"invoiceGroupId\":1770,\"confNumber\":\"15197557\",\"date\":\"2026-05-18\",\"refNumber\":\"1881682210 407290137\",\"clientNumber\":\"TQ47707Y\",\"carNumber\":\"9064\",\"errorDetails\":\"GPS pickup too far from medical facility\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"claimAmount\":\"52.32\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"disposition\":\"final_reattested\",\"approvedAmount\":null,\"invoiceNumbers\":\"1881682210\",\"payorEmail\":null,\"disputeEmailSent\":false,\"disputeEmailSentAt\":null,\"submittedVia\":\"portal\",\"importBatch\":\"import_1779201725402\",\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"includedInDispute\":true,\"sopNodeId\":\"node_1776188580433_18\",\"sopAnswers\":[{\"ts\":\"2026-05-20T17:39:49.978Z\",\"answer\":\"Yes, GPS data available\",\"nodeId\":\"node_1775761652235_04ve2\"},{\"ts\":\"2026-05-20T17:39:52.422Z\",\"answer\":\"Yes, route is reasonable\",\"nodeId\":\"node_1775761652235_kydhe\"},{\"ts\":\"2026-05-20T17:40:30.787Z\",\"answer\":\"Yes, route is reasonable\",\"nodeId\":\"node_1776188580433_18\"}],\"sopOutcome\":\"portal_dispute\",\"dropReason\":null,\"dropNote\":null,\"droppedAt\":null,\"readyAt\":\"2026-05-20T17:40:30.802Z\",\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":\"none\",\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"queued\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":\"1. Re-attest the invoice.\",\"attestationQueuedAt\":\"2026-05-21T18:50:17.534Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-05-19T14:42:08.086Z\",\"updatedAt\":\"2026-05-26T16:07:10.125Z\"},\"attestationOutcome\":\"queued\",\"outcomeAt\":\"2026-05-21T18:50:17.534Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":\"1. Re-attest the invoice.\"},{\"claim\":{\"id\":3259,\"invoiceGroupId\":1770,\"confNumber\":\"15197555\",\"date\":\"2026-05-18\",\"refNumber\":\"1881682210 407290138\",\"clientNumber\":\"TQ47707Y\",\"carNumber\":\"9064\",\"errorDetails\":\"\",\"errorTypeId\":null,\"errorTypeName\":null,\"claimAmount\":\"54.08\",\"status\":\"New\",\"outcome\":\"Pending\",\"disposition\":\"final_nonissue\",\"approvedAmount\":null,\"invoiceNumbers\":\"1881682210\",\"payorEmail\":null,\"disputeEmailSent\":false,\"disputeEmailSentAt\":null,\"submittedVia\":null,\"importBatch\":\"import_1779201725402\",\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"includedInDispute\":false,\"sopNodeId\":null,\"sopAnswers\":[],\"sopOutcome\":null,\"dropReason\":null,\"dropNote\":null,\"droppedAt\":null,\"readyAt\":null,\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":null,\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,