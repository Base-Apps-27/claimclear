closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T14:49:19.720Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:36:50.982Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:03.644Z\",\"updatedAt\":\"2026-05-14T14:49:19.720Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T14:49:19.720Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1069,\"invoiceNumber\":\"1866108300\",\"clientNumber\":\"BG38522J\",\"errorDetails\":\"GPS pickup too far from residence; Leg is in GPS Deviation Status.\",\"errorTypeId\":\"3\",\"errorTypeName\":\"GPS Pickup Too Far from Residence\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T14:46:50.509Z\",\"approvedAmount\":\"73.78\",\"rideCount\":2,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"73.78\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1866108300 - GPS Pickup Too Far from Residence (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the GPS Pickup Too Far from Residence flags on invoice 1866108300, covering Conf #15026027 and Conf #15026028, both serviced on 04/27/2026, and requesting that these trips be reconsidered for approval.\\n\\nFor both legs, GPS breadcrumb data is available and has been reviewed. On Conf #15026027 (Car 5097), the breadcrumb trail reasonably supports pickup at or near the member's residence, indicating no true deviation occurred. On Conf #15026028 (Car 1255), the GPS route supports a valid trip from pickup to drop-off, with no evidence of a routing irregularity that would warrant a deviation flag.\\n\\nThe attached GPS breadcrumb data for each leg directly contradicts the basis for these edits. The pickup and route data confirm that both trips were performed as authorized and that the GPS Deviation Status applied to this invoice does not reflect actual non-compliance. Based on this documentation, we request that both confirmations be approved in accordance with applicable guidelines.\",\"aiBaselineSubject\":\"Dispute - Invoice #1866108300 - GPS Pickup Too Far from Residence (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS Pickup Too Far from Residence flags on invoice 1866108300, covering Conf #15026027 and Conf #15026028, both serviced on 04/27/2026, and requesting that these trips be reconsidered for approval.\\n\\nFor both legs, GPS breadcrumb data is available and has been reviewed. On Conf #15026027 (Car 5097), the breadcrumb trail reasonably supports pickup at or near the member's residence, indicating no true deviation occurred. On Conf #15026028 (Car 1255), the GPS route supports a valid trip from pickup to drop-off, with no evidence of a routing irregularity that would warrant a deviation flag.\\n\\nThe attached GPS breadcrumb data for each leg directly contradicts the basis for these edits. The pickup and route data confirm that both trips were performed as authorized and that the GPS Deviation Status applied to this invoice does not reflect actual non-compliance. Based on this documentation, we request that both confirmations be approved in accordance with applicable guidelines.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T23:08:37.253Z\",\"draftEditedBy\":\"emil.j@agapeny.com\",\"draftReviewedAt\":\"2026-05-09T23:08:37.253Z\",\"