{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:stability:api": "STABILITY_MODE=default-parallel node scripts/test-stability/stress-api-server.mjs",
    "test:stability:api:shuffle": "STABILITY_MODE=shuffle node scripts/test-stability/stress-api-server.mjs",
    "test:stability:api:serial": "STABILITY_MODE=serial node scripts/test-stability/stress-api-server.mjs",
    "test:stability:api:suspects": "STABILITY_MODE=suspect-files node scripts/test-stability/stress-api-server.mjs",
    "test:stability:api:report": "node scripts/test-stability/render-api-server-report.mjs"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.46",
    "@base44/vite-plugin": "^1.0.34"
  }
}
