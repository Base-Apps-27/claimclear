nt\":2,\"daysLeft\":12,\"effectiveDaysLeft\":10,\"isUrgent\":false},{\"id\":1450,\"invoiceNumber\":\"1864010170\",\"earliestDate\":\"2026-05-08\",\"totalAmount\":\"30.05\",\"status\":\"New\",\"rideCount\":1,\"daysLeft\":12,\"effectiveDaysLeft\":10,\"isUrgent\":false},{\"id\":1451,\"invoiceNumber\":\"1875305230\",\"earliestDate\":\"2026-05-08\",\"totalAmount\":\"47.93\",\"status\":\"New\",\"rideCount\":1,\"daysLeft\":12,\"effectiveDaysLeft\":10,\"isUrgent\":false},{\"id\":1453,\"invoiceNumber\":\"1869813810\",\"earliestDate\":\"2026-05-08\",\"totalAmount\":\"45.94\",\"status\":\"New\",\"rideCount\":2,\"daysLeft\":12,\"effectiveDaysLeft\":10,\"isUrgent\":false},{\"id\":1432,\"invoiceNumber\":\"1873992330\",\"earliestDate\":\"2026-05-08\",\"totalAmount\":\"0.00\",\"status\":\"Resolved\",\"rideCount\":2,\"daysLeft\":12,\"effectiveDaysLeft\":10,\"isUrgent\":false}],\"urgentCount\":0,\"submittedStuckGroups\":[{\"id\":15,\"invoiceNumber\":\"1851554220\",\"earliestDate\":\"2026-04-14\",\"totalAmount\":\"138.74\",\"status\":\"Portal Queued\",\"rideCount\":2,\"daysLeft\":-12,\"effectiveDaysLeft\":-12,\"isUrgent\":true}],\"submittedStuckCount\":1,\"recentGroups\":[{\"id\":1770,\"invoiceNumber\":\"1881682210\",\"clientNumber\":\"TQ47707Y\",\"errorDetails\":\"GPS pickup too far from medical facility\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T16:07:09.910Z\",\"approvedAmount\":\"106.40\",\"rideCount\":2,\"serviceDate\":\"2026-05-18\",\"totalAmount\":\"106.40\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1881682210 - GPS Deviation Status (1 ride)\",\"draftDescriptionHtml\":\"We are disputing the GPS Deviation Status flag on Conf #15197557 (Invoice 1881682210) and requesting that this claim be reconsidered for approval.\\n\\nThe denial indicates that the GPS pickup location was too far from the medical facility, but this does not reflect a true deviation. GPS breadcrumb data is available for this trip and confirms that the route traveled reasonably supports a valid pickup-to-drop-off sequence. The flagged distance does not indicate a missed or improper pickup; it reflects a geographic discrepancy that the breadcrumb trail directly contradicts.\\n\\nThe available GPS data shows a logical and continuous route consistent with the authorized trip. Based on this documentation, this is a valid completed trip and we request that it be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1881682210 - GPS Deviation Status (1 ride)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS Deviation Status flag on Conf #15197557 (Invoice 1881682210) and requesting that this claim be reconsidered for approval.\\n\\nThe denial indicates that the GPS pickup location was too far from the medical facility, but this does not reflect a true deviation. GPS breadcrumb data is available for this trip and confirms that the route traveled reasonably supports a valid pickup-to-drop-off sequence. The flagged distance does not indicate a missed or improper pickup; it reflects a geographic discrepancy that the breadcrumb trail directly contradicts.\\n\\nThe available GPS data shows a logical and continuous route consistent with the authorized trip. Based on this documentation, this is a valid completed trip and we request that it be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-20T17:40:37.440Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":\"2026-05-20T17:40:41.427Z\",\"draftReviewedBy\":\"someidy.s@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-20T17:40:37.440Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-26T16:07:09.876Z\",\"reattestCo