l,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T14:46:56.881Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:37:21.641Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:03.724Z\",\"updatedAt\":\"2026-05-14T14:46:56.881Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T14:46:56.881Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1070,\"invoiceNumber\":\"1869989900\",\"clientNumber\":\"TD73761W\",\"errorDetails\":\"GPS pickup too far from medical facility\",\"errorTypeId\":\"4\",\"errorTypeName\":\"GPS Pickup Too Far from Medical Facility\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T14:34:19.574Z\",\"approvedAmount\":\"55.01\",\"rideCount\":1,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"55.01\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1869989900 - GPS Pickup Too Far from Medical Facility (1 ride)\",\"draftDescriptionHtml\":\"We are disputing the GPS Pickup Too Far from Medical Facility edit on Conf #15066106 (Invoice #1869989900) and requesting that this claim be reconsidered for approval.\\n\\nThe flag does not reflect a true deviation. GPS breadcrumb data is available for this trip and confirms that the pickup location was at or reasonably near the medical facility. The coordinates align with the authorized origin, and there is no actual displacement that would indicate a missed or incorrect pickup point.\\n\\nThe attached GPS breadcrumb data supports this position by mapping the vehicle's recorded position at the time of pickup directly to the service location. Based on this documentation, this is a valid trip and we request that the claim be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1869989900 - GPS Pickup Too Far from Medical Facility (1 ride)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS Pickup Too Far from Medical Facility edit on Conf #15066106 (Invoice #1869989900) and requesting that this claim be reconsidered for approval.\\n\\nThe flag does not reflect a true deviation. GPS breadcrumb data is available for this trip and confirms that the pickup location was at or reasonably near the medical facility. The coordinates align with the authorized origin, and there is no actual displacement that would indicate a missed or incorrect pickup point.\\n\\nThe attached GPS breadcrumb data supports this position by mapping the vehicle's recorded position at the time of pickup directly to the service location. Based on this documentation, this is a valid trip and we request that the claim be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T23:08:29.118Z\",\"draftEditedBy\":\"emil.j@agapeny.com\",\"draftReviewedAt\":\"2026-05-09T23:08:29.118Z\",\"draftReviewedBy\":\"emil.j@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-09T23:08:29.118Z\",\"previewGeneratedBy\":\"emil.j@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-14T14:34:19.544Z\",\"reattestCompletedBy\"