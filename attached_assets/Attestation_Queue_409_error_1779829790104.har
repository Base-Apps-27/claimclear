t\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:03.834Z\",\"updatedAt\":\"2026-05-14T14:30:02.691Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T14:30:02.691Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1073,\"invoiceNumber\":\"1868842010\",\"clientNumber\":\"TU05342X\",\"errorDetails\":\"Leg is in GPS Deviation Status.; GPS pickup too far from residence; Travel time is too short for distance traveled\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T14:27:46.655Z\",\"approvedAmount\":\"93.51\",\"rideCount\":2,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"93.51\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1868842010 - GPS Deviation Status (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the GPS Deviation Status flags on invoice 1868842010, covering two trips for client TU05342X, and requesting that both claims be reconsidered for approval.\\n\\nFor Conf #15054539 (Car 1520), the flagged deviation does not reflect an actual service failure. GPS breadcrumb data is available for this trip, and the recorded route reasonably supports a valid pickup-to-drop-off sequence. The flag indicating the pickup was too far from the residence is not substantiated by the underlying GPS data, which confirms the vehicle's actual position at time of pickup.\\n\\nFor Conf #15054536 (Car 1850), the travel time concern similarly does not hold up against the available trip timing data. A review of that data shows the recorded travel time is consistent with the distance traveled, and any apparent discrepancy is explainable based on trip-level factors. This is not a case where timing shortfalls reflect an incomplete or fraudulent trip.\\n\\nBoth trips were completed as authorized, and the supporting GPS and timing data confirm this. Based on the available documentation, these are valid trips and we request that the claims be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1868842010 - GPS Deviation Status (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS Deviation Status flags on invoice 1868842010, covering two trips for client TU05342X, and requesting that both claims be reconsidered for approval.\\n\\nFor Conf #15054539 (Car 1520), the flagged deviation does not reflect an actual service failure. GPS breadcrumb data is available for this trip, and the recorded route reasonably supports a valid pickup-to-drop-off sequence. The flag indicating the pickup was too far from the residence is not substantiated by the underlying GPS data, which confirms the vehicle's actual position at time of pickup.\\n\\nFor Conf #15054536 (Car 1850), the travel time concern similarly does not hold up against the available trip timing data. A review of that data shows the recorded travel time is consistent with the distance traveled, and any apparent discrepancy is explainable based on trip-level factors. This is not a case where timing shortfalls reflect an incomplete or fraudulent trip.\\n\\nBoth trips were completed as authorized, and the supporting GPS and timing data confirm this. Based on the available documentation, these are valid trips and we request that the claims be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T23:08:07.948Z\",\"draftEditedBy\":\"emil.j@agapeny.com\",\"draftReviewedAt\":\"2026-05-09T23:08:07.948Z\",\"draftReviewedBy\":\"emil.j@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-09T23:08:07.948Z\",\"previewGeneratedBy\":\"emil.j@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-14T14:27:46.623Z\",\"reattestCompletedBy\":\"someidy.s@agapeny.com\",\"reattestNote\":null,\"h