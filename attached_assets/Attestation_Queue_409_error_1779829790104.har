,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T15:09:09.516Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:24:46.004Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:02.995Z\",\"updatedAt\":\"2026-05-14T15:09:09.516Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T15:09:09.516Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1054,\"invoiceNumber\":\"1869343940\",\"clientNumber\":\"WM91548T\",\"errorDetails\":\"Leg is in GPS Deviation Status.; GPS pickup too far from residence\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T15:07:22.855Z\",\"approvedAmount\":\"65.96\",\"rideCount\":2,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"65.96\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1869343940 - GPS Deviation Status (2 rides)\",\"draftDescriptionHtml\":\"Reconsideration Request – GPS Deviation Status – Invoice #1869343940\\n\\nWe are disputing the GPS Deviation Status flags on Invoice #1869343940 and requesting reconsideration for Conf #15057791 and Conf #15057793, both serviced on 2026-04-27. Neither flag reflects a true deviation based on the documentation available for each trip.\\n\\nFor Conf #15057791 (Car 3944), GPS breadcrumb data is available and the recorded route reasonably supports a valid trip between the pickup and dropoff locations. The breadcrumb trail is consistent with a legitimate, completed transport and does not indicate any unauthorized deviation from the expected path.\\n\\nFor Conf #15057793 (Car 5112), breadcrumb data is likewise available and confirms that the pickup occurred at or near the member's residence. The GPS pickup concern does not hold up against the positional data on file, which places the vehicle appropriately at trip origin.\\n\\nBoth trips are supported by route and pickup evidence that directly addresses the stated denial reasons. These are valid, completed transports and we request that both claims be approved in accordance with the documentation provided.\",\"aiBaselineSubject\":\"Dispute - Invoice #1869343940 - GPS Deviation Status (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Reconsideration Request – GPS Deviation Status – Invoice #1869343940**\\n\\nWe are disputing the GPS Deviation Status flags on Invoice #1869343940 and requesting reconsideration for Conf #15057791 and Conf #15057793, both serviced on 2026-04-27. Neither flag reflects a true deviation based on the documentation available for each trip.\\n\\nFor Conf #15057791 (Car 3944), GPS breadcrumb data is available and the recorded route reasonably supports a valid trip between the pickup and dropoff locations. The breadcrumb trail is consistent with a legitimate, completed transport and does not indicate any unauthorized deviation from the expected path.\\n\\nFor Conf #15057793 (Car 5112), breadcrumb data is likewise available and confirms that the pickup occurred at or near the member's residence. The GPS pickup concern does not hold up against the positional data on file, which places the vehicle appropriately at trip origin.\\n\\nBoth trips are supported by route and pickup evidence that directly addresses the stated denial reasons. These are valid, completed transports and we request that both claims be approved in accordance with the documentation provided.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T18:27:22.088Z\",\"draftEditedBy\":\"KATIA.H@AGAPENY.COM\",\"draftReviewedAt\":\"2026-05-09T18:27:23.617Z\",\"draftReviewedBy\":\"KATIA.H@AGAPENY.COM\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-09T18:26:34.011Z\",\"previewGeneratedBy\":\"KATIA.H@AGAPENY.COM\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-14T15:07:22.823Z\",\"reattestCompletedBy\":\"someidy.s@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":true,\"disputeEmailSentAt\":\"2026-05-09T21:38:08.109Z\",\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"payorEmail\":null,\"payorDenialReason\":null,\"payorDenialReasonNote\":null,\"payorDenialReasonAt\":null,\"payorDenialReasonBy\":null,\"awaitingPayorAgainAt\":\"2026-05-14T12:25:34.921Z\",\"importBatch\":\"import_1777387119750\",\"isTourSample\":false,\"withdrawnAt\":null,\"draftDiscardedAt\":null,\"draftDiscardedSubject\":null,\"draftDiscardedDescriptio