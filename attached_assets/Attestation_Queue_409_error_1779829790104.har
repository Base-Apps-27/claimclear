sureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"queued\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-22T15:47:52.525Z\",\"attestationQueuedBy\":\"z7ytv7jcb4@privaterelay.appleid.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-05-04T15:53:28.690Z\",\"updatedAt\":\"2026-05-26T15:40:13.045Z\"},\"attestationOutcome\":\"queued\",\"outcomeAt\":\"2026-05-22T15:47:52.525Z\",\"outcomeBy\":\"z7ytv7jcb4@privaterelay.appleid.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1197,\"invoiceNumber\":\"1871055630\",\"clientNumber\":\"VU71149X\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T15:34:54.304Z\",\"approvedAmount\":\"60.10\",\"rideCount\":2,\"serviceDate\":\"2026-05-01\",\"totalAmount\":\"60.10\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1871055630 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1871055630, covering confirmation numbers 15075368 and 15075369 (both serviced on 05/01/2026), and requesting that these trips be reconsidered for approval.\\n\\nFor both rides, available GPS and trip timing data was reviewed and does not support the flagged concern. The timing data reasonably reflects the actual duration of the member's facility stay and does not indicate an abnormally short visit. The edit does not reflect a true deviation for either trip.\\n\\nThe attached trip timing records confirm that the documented facility time is consistent with a completed, legitimate transport. Based on the available data and applicable guidelines, both trips were performed as authorized and should be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1871055630 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1871055630, covering confirmation numbers 15075368 and 15075369 (both serviced on 05/01/2026), and requesting that these trips be reconsidered for approval.\\n\\nFor both rides, available GPS and trip timing data was reviewed and does not support the flagged concern. The timing data reasonably reflects the actual duration of the member's facility stay and does not indicate an abnormally short visit. The edit does not reflect a true deviation for either trip.\\n\\nThe attached trip timing records confirm that the documented facility time is consistent with a completed, legitimate transport. Based on the available data and applicable guidelines, both trips were performed as authorized and should be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-20T19:40:13.106Z\",\"draftEditedBy\":\"KATIA.H@AGAPENY.COM\",\"draftReviewedAt\":\"2026-05-20T19:40:21.509Z\",\"draftReviewedBy\":\"KATIA.H@AGAPENY.COM\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-20T19:40:13.106Z\",\"previewGeneratedBy\":\"KATIA.H@AGAPENY.COM\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-26T15:34:54.272Z\",\"reattestCompletedBy\":\"Grace@agapeny.com\",\"reattestNote\":null,\"holdRe