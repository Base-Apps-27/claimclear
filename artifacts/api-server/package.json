{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development pnpm run build && NODE_ENV=development PORT=8080 pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "bot:run": "npx tsx src/bot/portal-bot.ts",
    "bot:save-session": "npx tsx src/bot/save-session.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^3.0.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "openai": "^6.33.0",
    "openid-client": "^6.8.2",
    "pino": "^9",
    "pino-http": "^10",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
