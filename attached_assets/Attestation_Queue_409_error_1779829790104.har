ull,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T14:59:32.364Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:27:21.197Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:03.158Z\",\"updatedAt\":\"2026-05-14T14:59:32.365Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T14:59:32.364Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1059,\"invoiceNumber\":\"1859715960\",\"clientNumber\":\"YP48644C\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T14:58:05.541Z\",\"approvedAmount\":\"53.02\",\"rideCount\":2,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"53.02\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1859715960 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"Reconsideration Request – Time at Medical Facility Too Short – Invoice #1859715960\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice #1859715960 and requesting reconsideration for Conf #15028083 and Conf #15028081, both serviced on 2026-04-27 under client YP48644C.\\n\\nFor both trips, GPS and timing data are available and have been reviewed. That data does not support the denial -- the recorded facility stay for each trip is reasonable relative to the type of appointment and does not reflect an abnormally short visit. The flagged edit does not accurately represent what occurred.\\n\\nSupporting timing documentation is attached for both confirmations. The data confirms that the time logged at the facility aligns with a legitimate appointment and is not indicative of a documentation error or a trip that was not fully completed. These are valid trips and we request that both claims be approved in accordance with the documented evidence.\",\"aiBaselineSubject\":\"Dispute - Invoice #1859715960 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Reconsideration Request – Time at Medical Facility Too Short – Invoice #1859715960**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice #1859715960 and requesting reconsideration for Conf #15028083 and Conf #15028081, both serviced on 2026-04-27 under client YP48644C.\\n\\nFor both trips, GPS and timing data are available and have been reviewed. That data does not support the denial -- the recorded facility stay for each trip is reasonable relative to the type of appointment and does not reflect an abnormally short visit. The flagged edit does not accurately represent what occurred.\\n\\nSupporting timing documentation is attached for both confirmations. The data confirms that the time logged at the facility aligns with a legitimate appointment and is not indicative of a documentation error or a trip that was not fully completed. These are valid trips and we request that both claims be approved in accordance with the documented evidence.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T18:38:45.685Z\",\"draftEditedBy\":\"KATIA.H@AGAPENY.COM\",\"draftReviewedAt\":\"2026-05-09T18:38:47.713Z\",\"draftReviewe