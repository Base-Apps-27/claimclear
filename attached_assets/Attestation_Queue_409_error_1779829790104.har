:\"portal_dispute\",\"dropReason\":null,\"dropNote\":null,\"droppedAt\":null,\"readyAt\":\"2026-05-07T22:23:02.992Z\",\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":\"none\",\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-12T19:17:58.251Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-09T23:39:40.469Z\",\"attestationQueuedBy\":\"emil.j@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:06:13.089Z\",\"updatedAt\":\"2026-05-12T19:17:58.251Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-12T19:17:58.251Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":470,\"invoiceNumber\":\"1852610650\",\"clientNumber\":\"CF63817Q\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-12T17:54:59.610Z\",\"approvedAmount\":\"130.60\",\"rideCount\":2,\"serviceDate\":\"2026-04-10\",\"totalAmount\":\"130.60\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1852610650 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"**Dispute – Time at Medical Facility Too Short – Invoice #1852610650 (Conf #14928746 & #14928744)**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice #1852610650 and requesting reconsideration for both affected trips: Conf #14928746 and Conf #14928744, both serviced on 04/10/2026 by vehicle 2128 for client CF63817Q.\\n\\nThe abbreviated facility stay recorded for each trip does not reflect a true deviation. GPS and trip timing data are available for both confirmations, and the data supports a legitimate, explainable reason for the shortened time at the facility. The brief stay was situational rather than indicative of an incomplete or improper transport.\\n\\nThe available timing data confirms that the member was transported to and from the facility as scheduled. Based on the GPS records and the documented explanation for the short stay, these trips were completed in full compliance with applicable guidelines, and we request that both claims be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1852610650 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Dispute – Time at Medical Facility Too Short – Invoice #1852610650 (Conf #14928746 & #14928744)**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice #1852610650 and requesting reconsideration for both affected trips: Conf #14928746 and Conf #14928744, both serviced on 04/10/2026 by vehicle 2128 for client CF63817Q.\\n\\nThe abbreviated facility stay recorded for each trip does not reflect a true deviation. GPS and trip timing data are available for both confirmations, and the data supports a legitimate, explainable reason for the shortened time at the facility. The brief stay was situational rather than indicative of an incomplete or improper transport.\\n\\nThe available timing data confirms that the member was transported to and from the facility as scheduled. Based on the GPS records and the documented explanation for the short stay, these trips were completed in full compliance with applicable guidelines, and we request that both claims be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-07T22:09:04.054Z\",\"draftEditedBy\":\"daniel.m@agapeny.com\",\"draftReviewedAt\":\"2026-05-07T22:09:06.162Z\",\"draftReviewedBy\":\"daniel.m@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-07T22:09:04.054Z\",\"previewGeneratedBy\":\"daniel.m@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-12T17:54:59.574Z\",\"reattestCompletedBy\":\"someidy.s@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":true,\"disputeEmailSentAt\":\"2026-05-08T02:00:28.566Z\",\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"payorEmail\":null,\"payorDenialReason\":null,\"payorDenialReasonNote\":null,\"payorDenialReasonAt\":null,\"payorDenialReasonBy\":null,\"awaitingPayorAgainAt\":\"2026-05-11T13:32:44.225Z\",\"importBatch\":\"import_1777385152477\",\"isTourSample\":false,\"withdrawnAt\":null,\"draftDiscardedAt\":null,\"draftDiscardedSubject\"