nCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T14:54:07.846Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:35:15.146Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:03.361Z\",\"updatedAt\":\"2026-05-14T14:54:07.846Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T14:54:07.846Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1063,\"invoiceNumber\":\"1793869460\",\"clientNumber\":\"TT39584D\",\"errorDetails\":\"GPS pickup too far from medical facility; Travel time is too short for distance traveled; Leg is in GPS Deviation Status.\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T14:52:27.938Z\",\"approvedAmount\":\"145.14\",\"rideCount\":2,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"145.14\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1793869460 - GPS Deviation Status (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the GPS Deviation Status flags on invoice 1793869460 for Conf #15026455 and Conf #15026457, both serviced on 04/27/2026, and requesting that these trips be reconsidered for approval.\\n\\nFor Conf #15026455 (Car 3079), the recorded travel time, while flagged as too short for the distance, is reasonably supported by the available timing data. A supportable explanation exists for the discrepancy, and the flag does not reflect a true deviation in how the trip was performed.\\n\\nFor Conf #15026457 (Car 4578), available GPS breadcrumb data confirms that the route traveled reasonably supports a valid trip from pickup to drop-off. The GPS route does not indicate a missed pickup or improper trip path, and the deviation flag is not consistent with what the data shows.\\n\\nTaken together, the trip records and GPS data for both confirmations demonstrate that valid transportation was provided as authorized. We request that these trips be approved in accordance with the supporting documentation.\",\"aiBaselineSubject\":\"Dispute - Invoice #1793869460 - GPS Deviation Status (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS Deviation Status flags on invoice 1793869460 for Conf #15026455 and Conf #15026457, both serviced on 04/27/2026, and requesting that these trips be reconsidered for approval.\\n\\nFor Conf #15026455 (Car 3079), the recorded travel time, while flagged as too short for the distance, is reasonably supported by the available timing data. A supportable explanation exists for the discrepancy, and the flag does not reflect a true deviation in how the trip was performed.\\n\\nFor Conf #15026457 (Car 4578), available GPS breadcrumb data confirms that the route traveled reasonably supports a valid trip from pickup to drop-off. The GPS route does not indicate a missed pickup or improper trip path, and the deviation flag is not consistent with what the data shows.\\n\\nTaken together, the trip records and GPS data for both confirmations demonstrate that valid transportation was provided as authorized. We request that these trips be approved in accordance with the supporting documentation.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T23:08:53.517Z\",\"draftEditedBy\":\"emil.j@agapeny.com\",\"draftReviewedAt\":\"2026-05-09T23:08:53.517Z\",\"draftReviewedBy\":\"emil.j@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-09T23:08:53.517Z\",\"previewGeneratedBy\":\"emil.j@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-14T14:52:27.909Z\",\"reattestCompletedBy\":\"someidy.s@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":true,\"disputeEmailSentAt\":\"2026-05-09T23:37:19.378Z\",\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"payorEmail\":null,\"payorDenialReason\":null,\"payorDenialReasonNote\":null,\"payorDenialReasonAt\":null,\"payorDenialReasonBy\":null,\"awaitingPayorAgainAt\":\"2026-05-14T12:35:44.070Z\",\"importBatch\":\"import_1777387119750\",\"isTourSample\":false,\"withdrawnAt\":null,\"draftDiscardedAt\":null,\"draftDiscardedSubject\":null,\"draftDiscardedDescriptionHtml\":null,\"isOpen\":false,\"createdAt\":\"2026-04-28T14:39:03.424Z\",\"updatedAt\":\"2026-05-14T14:52:27.969Z\"},\"legs\":[{\"cla