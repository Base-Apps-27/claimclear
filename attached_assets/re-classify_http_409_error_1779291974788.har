adbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":null,\"previewGeneratedBy\":null,\"reattestRequired\":false,\"reattestCompletedAt\":null,\"reattestCompletedBy\":null,\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"disputeEmailSent\":false,\"disputeEmailSentAt\":null,\"generatedEmailSubject\":null,\"generatedEmailBody\":null,\"generatedEmailAt\":null,\"evidenceFiles\":null,\"evidenceNotes\":null,\"evidenceChecklist\":null,\"payorEmail\":null,\"payorDenialReason\":null,\"payorDenialReasonNote\":null,\"payorDenialReasonAt\":null,\"payorDenialReasonBy\":null,\"awaitingPayorAgainAt\":null,\"importBatch\":\"import_1779120585632\",\"isTourSample\":false,\"isOpen\":true,\"createdAt\":\"2026-05-18T16:09:50.733Z\",\"updatedAt\":\"2026-05-18T16:09:50.803Z\",\"earliestDate\":\"2026-05-17\",\"effectiveDaysLeft\":27,\"isUrgent\":false,\"submittedStuck\":false,\"legSubStatusCounts\":{\"investigating\":1,\"excluded\":1},\"serviceDateReason\":\"has_date\",\"eligibility\":{\"applyErrorType\":{\"eligible\":true,\"reason\":null},\"submitToPortal\":{\"eligible\":false,\"reason\":\"not_reviewed\"},\"generateAndReview\":{\"eligible\":false,\"reason\":\"not_packageable\"},\"reattest\":{\"eligible\":false,\"reason\":\"has_disputable_legs\"},\"close\":{\"eligible\":false,\"reason\":\"has_disputable_legs\"}},\"legCount\":2,\"primaryLeg\":{\"id\":3197,\"confNumber\":\"15169955\"}},{\"id\":1784,\"invoiceNumber\":\"1851234700\",\"clientNumber\":\"MG18351H\",\"errorDetails\":\"GPS pickup too far from residence; Travel time is too short for distance traveled; Leg is in GPS Deviation Status.\",\"errorTypeId\":\"13\",\"errorTypeName\":\"Travel Time Too Short for Distance Traveled\",\"status\":\"New\",\"outcome\":\"Pending\",\"phase\":\"triage\",\"phaseEnteredAt\":\"2026-05-19T14:42:09.362Z\",\"approvedAmount\":null,\"rideCount\":2,\"serviceDate\":\"2026-05-18\",\"totalAmount\":\"135.48\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1851234700 - Travel Time Too Short for Distance Traveled (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the Travel Time Too Short for Distance Traveled flag on invoice 1851234700, covering Conf #15159377 and Conf #15159379, both serviced on 05/18/2026, and requesting that these claims be reconsidered for approval.\\n\\nFor Conf #15159377 (Car 932), GPS and timing data are not available for this trip; however, alternate documentation supporting trip completion and route activity has been identified and is being submitted to substantiate that the service was rendered as authorized. The absence of GPS data does not reflect a deviation — it reflects a data gap that alternate records directly address.\\n\\nFor Conf #15159379 (Car 81), GPS breadcrumb data is available and confirms a reasonable route from pickup to drop-off. The flagged deviation does not hold up against the breadcrumb record, which shows the vehicle traveled a route consistent with the authorized trip. The Travel Time Too Short flag and GPS Deviation Status are not supported by the actual route data on file.\\n\\nTaken together, the available documentation for both legs demonstrates that these were valid, completed trips. We request that invoice 1851234700 be approved in accordance with the supporting evidence and applicable guidelines.\",\"aiBaselineSubject\":\"Dispute - Invoice #1851234700 - Travel Time Too Short for Distance Traveled (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the Travel Time Too Short for Distance Traveled flag on invoice 1851234700, covering Conf #15159377 and Conf #15159379, both serviced on 05/18/2026, and requesting that these claims be reconsidered for approval.\\n\\nFor Conf #15159377 (Car 932), GPS and timing data are not available for this trip; however, alternate documentation supporting trip completion and route activity has been identified and is being submitted to substantiate that the service was rendered as authorized. The absence of GPS data does not reflect a deviation — it reflects a data gap that alternate records directly address.\\n\\nFor Conf #15159379 (Car 81), GPS breadcrumb data is available and confirms a reasonable route from pickup to drop-off. The flagged deviation does not hold up against the breadcrumb record, which shows the vehicle traveled a route consistent with the authorized trip. The Travel Time Too Short flag and GPS Deviation Status are not supported by the actual route data on file.\\n\\nTaken together, the available documentation for both legs demonstrates that these were valid, completed trips. We request that invoice 1851234700 be approved in accordance with the supporting evidence and applicable guidelines.\",\"draftEditedAt\":\"2026-05-20T15:44:35.226Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":null,\"draftReviewedBy\":null,\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-20T15:44:35.226Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":false,\"reattestCompletedAt\":null,\"reattestCompletedBy\":null,\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCa