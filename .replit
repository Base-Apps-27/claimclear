modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[deployment]
router = "application"
deploymentTarget = "autoscale"

# Pre-build hook: runs at the repo root BEFORE any artifact-specific build.
# Migrations are isolated here (instead of being chained inside an artifact's
# production.build) so:
#   1. The migration step is its own line in the build log, making it
#      obvious when prod's schema was advanced.
#   2. A single failed publish only ever advances the schema once.
# We use the custom non-interactive runner (lib/db/scripts/apply-migrations.mjs)
# instead of `drizzle-kit push --force` because `push --force` only skips
# data-loss prompts, NOT rename-disambiguation prompts. In a non-TTY build
# the rename prompt hangs/exits without applying anything, so the build
# "succeeds" but ships code against an unmigrated DB. See the May-1-2026
# production incident and Task #340.
[deployment.build]
args = ["pnpm", "--filter", "@workspace/db", "run", "migrate"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift"

[[workflows.workflow]]
name = "schema-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run check-drift"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["outlook:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-aa15283a-2ca4-4bf5-b949-fffbd7690c1c"

[userenv]

[userenv.shared]
BOT_SERVICE_TOKEN = "0a813f710d64667100d51fc992fbf9c1e81f58f900d76e2e8941ce05608d5183"
MAS_PORTAL_URL = "https://tpissues.medanswering.com"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80
