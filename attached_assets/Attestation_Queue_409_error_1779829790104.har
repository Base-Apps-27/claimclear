To\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"queued\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":\"1. Re-attest the invoice.\",\"attestationQueuedAt\":\"2026-05-22T12:30:43.716Z\",\"attestationQueuedBy\":\"daniel.m@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-05-04T15:53:28.945Z\",\"updatedAt\":\"2026-05-26T15:34:54.576Z\"},\"attestationOutcome\":\"queued\",\"outcomeAt\":\"2026-05-22T12:30:43.716Z\",\"outcomeBy\":\"daniel.m@agapeny.com\",\"outcomeNote\":\"1. Re-attest the invoice.\"}]},{\"group\":{\"id\":1158,\"invoiceNumber\":\"1862600470\",\"clientNumber\":\"MH23081D\",\"errorDetails\":\"GPS pickup too far from residence; Travel time is too short for distance traveled\",\"errorTypeId\":\"13\",\"errorTypeName\":\"Travel Time Too Short for Distance\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T15:22:32.718Z\",\"approvedAmount\":\"69.50\",\"rideCount\":1,\"serviceDate\":\"2026-04-29\",\"totalAmount\":\"69.50\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1862600470 - Claim Correction (1 ride)\",\"draftDescriptionHtml\":\"We are disputing the GPS pickup distance and travel time flags on Conf #15045403 (Invoice 1862600470) and requesting that this claim be reconsidered for approval.\\n\\nThe flagged issues do not reflect a true deviation for this trip. Trip timing data was reviewed and determined to reasonably support the distance traveled, and a valid explanation for any apparent discrepancy has been identified. The GPS pickup flag similarly does not indicate a compliance failure given the verified trip activity on record.\\n\\nAvailable timing data confirms the trip was completed as authorized. Based on the documentation and applicable guidelines, this is a valid trip and we request that it be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1862600470 - Claim Correction (1 ride)\",\"aiBaselineDescriptionHtml\":\"We are disputing the GPS pickup distance and travel time flags on Conf #15045403 (Invoice 1862600470) and requesting that this claim be reconsidered for approval.\\n\\nThe flagged issues do not reflect a true deviation for this trip. Trip timing data was reviewed and determined to reasonably support the distance traveled, and a valid explanation for any apparent discrepancy has been identified. The GPS pickup flag similarly does not indicate a compliance failure given the verified trip activity on record.\\n\\nAvailable timing data confirms the trip was completed as authorized. Based on the documentation and applicable guidelines, this is a valid trip and we request that it be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-21T15:47:29.439Z\",\"draftEditedBy\":\"someidy.s@agapeny.com\",\"draftReviewedAt\":\"2026-05-21T15:47:40.857Z\",\"draftReviewedBy\":\"someidy.s@agapeny.com\",\"specialCircumstances\":null,\"understandingReadback\":null,\"understandingReadbackForText\":null,\"understandingReadbackAt\":null,\"understandingReadbackBy\":null,\"previewGeneratedAt\":\"2026-05-21T15:47:29.439Z\",\"previewGeneratedBy\":\"someidy.s@agapeny.com\",\"reattestRequired\":true,\"reattestCompletedAt\":\"2026-05-26T15:22:32.687Z\",\"reattestCompletedBy\":\"Grace@agapeny.com\",\"reattestNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":\"reattested\",\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closure