":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-14T14:55:30.569Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-14T12:34:43.485Z\",\"attestationQueuedBy\":\"someidy.s@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:39:03.309Z\",\"updatedAt\":\"2026-05-14T14:55:30.570Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-14T14:55:30.569Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":1061,\"invoiceNumber\":\"1869386580\",\"clientNumber\":\"VZ50718Z\",\"errorDetails\":\"GPS pickup too far from medical facility; Travel time is too short for distance traveled; Leg is in GPS Deviation Status.\",\"errorTypeId\":\"6\",\"errorTypeName\":\"GPS Deviation Status\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-14T14:54:03.199Z\",\"approvedAmount\":\"181.65\",\"rideCount\":2,\"serviceDate\":\"2026-04-27\",\"totalAmount\":\"181.65\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1869386580 - GPS Deviation Status (2 rides)\",\"draftDescriptionHtml\":\"Dispute – GPS Deviation Status – Invoice #1869386580 (Conf #15061547 & #15061546)\\n\\nWe are disputing the GPS Deviation Status flags on both rides under invoice #1869386580 and requesting that these claims be reconsidered for approval.\\n\\nFor Conf #15061547 (Car 381), trip timing data is available and confirms that the recorded travel time reasonably supports the distance covered. The flagged discrepancy has a documented, explainable cause and does not reflect a failure to complete the trip as authorized. For Conf #15061546 (Car 857), GPS breadcrumb data is available, and the route traced between pickup and drop-off is consistent with a valid, completed trip. Neither ride reflects a true deviation from the expected service path.\\n\\nThe available GPS and timing records for both legs directly address the basis for the flags. The route data for Conf #15061546 supports valid trip completion, and the timing data for Conf #15061547 aligns with actual conditions on the date of service. Taken together, this documentation confirms that both trips were performed as scheduled on 04/27/2026 for client VZ50718Z. These are valid trips and we request that both be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1869386580 - GPS Deviation Status (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Dispute – GPS Deviation Status – Invoice #1869386580 (Conf #15061547 & #15061546)**\\n\\nWe are disputing the GPS Deviation Status flags on both rides under invoice #1869386580 and requesting that these claims be reconsidered for approval.\\n\\nFor Conf #15061547 (Car 381), trip timing data is available and confirms that the recorded travel time reasonably supports the distance covered. The flagged discrepancy has a documented, explainable cause and does not reflect a failure to complete the trip as authorized. For Conf #15061546 (Car 857), GPS breadcrumb data is available and the route traced between pickup and dropoff is consistent with a valid, completed trip. Neither ride reflects a true deviation from the expected service path.\\n\\nThe available GPS and timing records for both legs directly address the basis for the flags. The route data for Conf #15061546 supports valid trip completion, and the timing data for Conf #15061547 aligns with actual conditions on the date of service. Taken together, this documentation confirms that both trips were performed as scheduled on 04/27/2026 for client VZ50718Z. These are valid trips and we request that both be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-09T18:48:36.873Z\",\"draftEditedBy\":\"KATIA.H@AGAPENY.COM\",\"draftReviewedAt\":\"2026-05-09T18:48:37.320Z\",\"draftR