:\"portal_dispute\",\"dropReason\":null,\"dropNote\":null,\"droppedAt\":null,\"readyAt\":null,\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":null,\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"not_required\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":null,\"attestationQueuedAt\":null,\"attestationQueuedBy\":null,\"isOpen\":true,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-15T15:05:25.403Z\",\"updatedAt\":\"2026-05-13T02:59:14.023Z\"},\"attestationOutcome\":\"not_required\",\"outcomeAt\":null,\"outcomeBy\":null,\"outcomeNote\":null}]},{\"group\":{\"id\":297,\"invoiceNumber\":\"1761763390\",\"clientNumber\":\"ZS23943N\",\"errorDetails\":\"MAS: Ineligible enrolee\",\"errorTypeId\":\"12\",\"errorTypeName\":\"Ineligible Enrollee\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-07T00:50:57.113Z\",\"approvedAmount\":\"45.94\",\"rideCount\":2,\"serviceDate\":\"2026-04-04\",\"totalAmount\":\"45.94\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1761763390 - Ineligible Enrollee (2 rides)\",\"draftDescriptionHtml\":\"**Subject: Dispute – Ineligible Enrollee – Invoice #1761763390**\\n\\nWe are disputing the \\\"Ineligible Enrollee\\\" denial on Invoice #1761763390 and requesting reconsideration for Conf #14926605 and Conf #14926621. Our review of the available records confirms that the member associated with client ZS23943N was present and the trips are documented in the system — eligibility on the service date of April 4, 2026, remains supportable and does not align with the denial as issued.\\n\\nThe ineligibility determination does not accurately reflect the member's status on the date of service. Based on our internal workflow review, there is sufficient documentation to support that this enrollee's eligibility can be substantiated for this trip date, and the denial should not stand as-is. Supporting documentation is attached for MAS review.\\n\\nThese are valid trips and we are requesting that both confirmation numbers be approved for submission accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1761763390 - Ineligible Enrollee (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Subject: Dispute – Ineligible Enrollee – Invoice #1761763390**\\n\\nWe are disputing the \\\"Ineligible Enrollee\\\" denial on Invoice #1761763390 and requesting reconsideration for Conf #14926605 and Conf #14926621. Our review of the available records confirms that the member associated with client ZS23943N was present and the trips are documented in the system — eligibility on the service date of April 4, 2026, remains supportable and does not align with the denial as issued.\\n\\nThe ineligibility determination does not accurately reflect the member's status on the date of service. Based on our internal workflow review, there is sufficient documentation to support that this enrollee's eligibility can be substantiated for this trip date, and the denial should not stand as-is. Supporting documentation is attached for MAS review.\\n\\nThese are valid trips and we are requesting that both confirmation numbers be approved for submission accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-05T00:53:29.626Z\",\"draftEditedBy\":\"emil.j@agapeny.com