At\":\"2026-05-20T18:34:24.754Z\",\"perLegContext\":null,\"duplicateOfClaimId\":null,\"masActionRequired\":\"none\",\"masActionCompletedAt\":null,\"masActionCompletedBy\":null,\"masActionNote\":null,\"holdReason\":null,\"holdPendingFrom\":null,\"holdPlacedAt\":null,\"triageNotes\":null,\"triagedAt\":null,\"closureReason\":null,\"closureCategory\":null,\"closureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"queued\",\"attestedAt\":null,\"attestedBy\":null,\"attestationNote\":\"1. Re-attest the invoice.\",\"attestationQueuedAt\":\"2026-05-22T13:23:23.644Z\",\"attestationQueuedBy\":\"daniel.m@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-30T15:09:06.935Z\",\"updatedAt\":\"2026-05-26T14:45:22.458Z\"},\"attestationOutcome\":\"queued\",\"outcomeAt\":\"2026-05-22T13:23:23.644Z\",\"outcomeBy\":\"daniel.m@agapeny.com\",\"outcomeNote\":\"1. Re-attest the invoice.\"}]},{\"group\":{\"id\":1121,\"invoiceNumber\":\"1868046220\",\"clientNumber\":\"WH04426J\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-26T14:35:34.856Z\",\"approvedAmount\":\"45.94\",\"rideCount\":2,\"serviceDate\":\"2026-04-28\",\"totalAmount\":\"45.94\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1868046220 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1868046220, covering Conf #15041696 and Conf #15041697 (both serviced on 2026-04-28 by vehicle 4648), and requesting that these claims be reconsidered for approval.\\n\\nFor both trips, GPS and timing data are available and confirm that the member did attend the medical facility. The recorded facility stay may appear brief in the system, but there is a supportable explanation for the short duration — the visit length reflects the actual nature of the appointment, not a failure to transport or a missed stop. This is not a true deviation from the authorized service.\\n\\nTrip logs and GPS timing data are attached and demonstrate that the member was dropped off and picked up at the facility as scheduled. These records support that both trips were completed as authorized. Based on the available documentation, we request that both confirmations be approved in accordance with applicable guidelines.\",\"aiBaselineSubject\":\"Dispute - Invoice #1868046220 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"We are disputing the \\\"Time at Medical Facility Too Short\\\" flag on invoice 1868046220, covering Conf #15041696 and Conf #15041697 (both serviced on 2026-04-28 by vehicle 4648), and requesting that these claims be reconsidered for approval.\\n\\nFor both trips, GPS and timing data are available and confirm that the member did attend the medical facility. The recorded facility stay may appear brief in the system, but there is a supportable explanation for the short duration — the visit length reflects the actual nature of the appointment, not a failure to transport or a missed stop. This is not a true deviation from the authorized service.\\n\\nTrip logs and GPS timing data are attached and demonstrate that the member was dropped off and picked up at the facility as scheduled. These records support that both trips were completed as authorized. Based on the available documentation, we request that both confirmati