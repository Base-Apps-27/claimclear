ureCategoryOther\":null,\"closureRootCause\":null,\"closureRootCauseOther\":null,\"closureNarrative\":null,\"closureAccountabilityTags\":null,\"closureAccountabilityOther\":null,\"closureDrivers\":null,\"closureDispatchers\":null,\"closureCommunicatedTo\":null,\"closureResponsibility\":null,\"closureReviewState\":null,\"closureAddressedAt\":null,\"closureAddressedBy\":null,\"closureAddressedByEmail\":null,\"closureReviewNotes\":null,\"attestationState\":\"completed\",\"attestedAt\":\"2026-05-12T19:18:58.203Z\",\"attestedBy\":\"someidy.s@agapeny.com\",\"attestationNote\":null,\"attestationQueuedAt\":\"2026-05-09T23:39:25.918Z\",\"attestationQueuedBy\":\"emil.j@agapeny.com\",\"isOpen\":false,\"isTourSample\":false,\"withdrawnAt\":null,\"removedOfflineAt\":null,\"createdAt\":\"2026-04-28T14:06:13.188Z\",\"updatedAt\":\"2026-05-12T19:18:58.204Z\"},\"attestationOutcome\":\"attested\",\"outcomeAt\":\"2026-05-12T19:18:58.203Z\",\"outcomeBy\":\"someidy.s@agapeny.com\",\"outcomeNote\":null}]},{\"group\":{\"id\":473,\"invoiceNumber\":\"1811560110\",\"clientNumber\":\"FP11388E\",\"errorDetails\":\"Time at medical facility too short\",\"errorTypeId\":\"7\",\"errorTypeName\":\"Time at Medical Facility Too Short\",\"status\":\"Resolved\",\"outcome\":\"Approved\",\"phase\":\"closed\",\"phaseEnteredAt\":\"2026-05-12T17:56:50.658Z\",\"approvedAmount\":\"46.64\",\"rideCount\":2,\"serviceDate\":\"2026-04-10\",\"totalAmount\":\"46.64\",\"groupContext\":null,\"draftSubject\":\"Dispute - Invoice #1811560110 - Time at Medical Facility Too Short (2 rides)\",\"draftDescriptionHtml\":\"**Dispute – Time at Medical Facility Too Short – Invoice #1811560110 (Conf #14929498 & #14929497)**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" flag on both trips under invoice #1811560110 and requesting that these claims be reconsidered for approval. The rides in question, Conf #14929498 and Conf #14929497, were completed on 04/10/2026 by vehicle 920 for client FP11388E.\\n\\nGPS and trip timing data are available for both confirmations and have been reviewed. While the recorded facility dwell time may appear brief, there is a supportable explanation for the short stay in each case. The flagged duration does not reflect a failure to render service or a trip that was not completed as authorized.\\n\\nThe available timing data substantiates that the member was transported to and from the facility as scheduled. Based on the documentation on file and the explainable circumstances surrounding the facility time, these trips represent valid, completed transport and we request that both confirmations be approved accordingly.\",\"aiBaselineSubject\":\"Dispute - Invoice #1811560110 - Time at Medical Facility Too Short (2 rides)\",\"aiBaselineDescriptionHtml\":\"**Dispute – Time at Medical Facility Too Short – Invoice #1811560110 (Conf #14929498 & #14929497)**\\n\\nWe are disputing the \\\"Time at Medical Facility Too Short\\\" flag on both trips under invoice #1811560110 and requesting that these claims be reconsidered for approval. The rides in question, Conf #14929498 and Conf #14929497, were completed on 04/10/2026 by vehicle 920 for client FP11388E.\\n\\nGPS and trip timing data are available for both confirmations and have been reviewed. While the recorded facility dwell time may appear brief, there is a supportable explanation for the short stay in each case. The flagged duration does not reflect a failure to render service or a trip that was not completed as authorized.\\n\\nThe available timing data substantiates that the member was transported to and from the facility as scheduled. Based on the documentation on file and the explainable circumstances surrounding the facility time, these trips represent valid, completed transport and we request that both confirmations be approved accordingly.\",\"draftAttribution\":null,\"draftEditedAt\":\"2026-05-07T22:23:16.973Z\",\"draftEditedBy\":\"daniel.m@agapeny.com\",\"draftReviewedAt\":\"2026-05-07T22:23:1